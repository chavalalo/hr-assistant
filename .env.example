# Variables del HR Assistant. Copia este archivo a .env y llena lo que falte.
# Nunca subas .env al repositorio: CF_API_TOKEN, CF_AIG_TOKEN y API_KEYS son
# secretos.

# Entorno: development o production (production aplica las reglas de compliance)
ENVIRONMENT=development

# Clientes y claves, con la forma cliente:clave,cliente2:clave2 (secreto).
# Vacía: nadie puede usar POST /ask ni GET /metrics. En production cada clave
# debe tener 16 caracteres o más.
API_KEYS=

# Peticiones por cliente por minuto en POST /ask y GET /metrics
RATE_LIMIT_PER_MINUTE=30

# Clientes de API_KEYS que pueden leer GET /metrics, separados por coma. Los demás
# reciben 403. Vacía: todos (solo desarrollo). En production es obligatoria y cada
# nombre debe estar en API_KEYS.
METRICS_CLIENTS=

# Largo máximo de la respuesta; el revisor de salida la recorta (entero mayor que 0)
MAX_ANSWER_CHARS=1500

# Modelo: fake (simulado, sin red) o gateway (Cloudflare Workers AI por AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json
# Políticas de RR. HH. que consulta el especialista de políticas
POLICIES_PATH=data/policies.json

# Cloudflare: obligatorias con MODEL_PROVIDER=gateway
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=
# Opcional (secreto): token de AI Gateway autenticado; si tiene valor se manda en
# cf-aig-authorization. Nunca aparece en el log, la traza ni un error.
CF_AIG_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Resiliencia: reintentos del gateway ante timeout, 429 o 5xx (entero, 0 o más),
# primera espera en segundos (se duplica en cada reintento) y respaldo con el otro
# modelo (MODEL_SMALL <-> MODEL_LARGE) una sola vez (true o false)
MODEL_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.5
MODEL_FALLBACK=true
# Solo con MODEL_PROVIDER=fake: modelos simulados que fallan como el gateway,
# separados por coma (para probar el respaldo sin red)
FAKE_UNAVAILABLE_MODELS=

# Caché de respuestas en memoria: vida en segundos (0: apagada) y tope de entradas.
# Solo para preguntas sin historial y sin datos personales.
ANSWER_CACHE_TTL_SECONDS=0
ANSWER_CACHE_MAX_ENTRIES=256

# Observabilidad
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true
