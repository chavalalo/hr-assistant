# Variables del HR Assistant. Copia este archivo a .env y llena lo que falte.
# Nunca subas .env al repositorio: CF_API_TOKEN y API_KEYS son secretos.

# Entorno: development o production (production aplica las reglas de compliance)
ENVIRONMENT=development

# Clientes y claves, con la forma cliente:clave,cliente2:clave2 (secreto).
# Vacía: nadie puede usar POST /ask ni GET /metrics. En production cada clave
# debe tener 16 caracteres o más.
API_KEYS=

# Peticiones por cliente por minuto en POST /ask y GET /metrics
RATE_LIMIT_PER_MINUTE=30

# Modelo: fake (simulado, sin red) o gateway (Cloudflare Workers AI por AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Cloudflare: obligatorias con MODEL_PROVIDER=gateway
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Observabilidad
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true
